# Copy to .env and fill in. Never commit .env.

BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://nexterpay:nexterpay@localhost:5432/nexterpay_ops
REDIS_URL=redis://localhost:6379/0

# Used by docker-compose only.
POSTGRES_USER=nexterpay
POSTGRES_PASSWORD=
POSTGRES_DB=nexterpay_ops

# Telegram user id treated as administrator until a real administrator exists
# in the database. Needed once, to bootstrap. Clear it afterwards.
ADMIN_BOOTSTRAP_ID=

# Agreed with NexterPay: clients reply to the bot's acknowledgement, which
# carries the reference number. Do not change without a decision on record.
REPLY_ROUTING_STRATEGY=reply_to_ack

# Staff messages reach the client only via /reply. Plain messages in a topic
# stay internal. This is a safety property, not a preference.
OUTBOUND_COMMAND=reply

# Tell the client when their request is closed. Open question A2.
NOTIFY_CLIENT_ON_CLOSE=true

LOG_LEVEL=INFO
DEBUG_SQL=false
